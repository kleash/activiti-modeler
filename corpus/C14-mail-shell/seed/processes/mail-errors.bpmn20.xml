<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             id="Definitions_mailErrors"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C14">
  <process id="mailErrors" name="Mail errors and ignoreException" isExecutable="true">
    <documentation>A mail task whose recipient comes from the process variable recipient. With ignoreException true a failure (an invalid recipient here) is swallowed, its message is stored in the variable named by exceptionVariableName and the process goes on; with ignoreException false the exception fails the call.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_sendStrict" sourceRef="start" targetRef="sendStrict"/>
    <serviceTask id="sendStrict" name="Send a mail" activiti:type="mail">
      <extensionElements>
        <activiti:field name="to">
          <activiti:expression>${recipient}</activiti:expression>
        </activiti:field>
        <activiti:field name="from">
          <activiti:string>shop@corpus.test</activiti:string>
        </activiti:field>
        <activiti:field name="subject">
          <activiti:string>Strict mail</activiti:string>
        </activiti:field>
        <activiti:field name="text">
          <activiti:string>Mail that may fail.</activiti:string>
        </activiti:field>
        <activiti:field name="ignoreException">
          <activiti:expression>${ignore}</activiti:expression>
        </activiti:field>
        <activiti:field name="exceptionVariableName">
          <activiti:string>mailError</activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f_sendStrict_afterMail" sourceRef="sendStrict" targetRef="afterMail"/>
    <serviceTask id="afterMail" name="Continue" activiti:expression="${execution.setVariable('continued', true)}"/>
    <sequenceFlow id="f_afterMail_captureRecipient" sourceRef="afterMail" targetRef="captureRecipient"/>
    <serviceTask id="captureRecipient" name="Capture the recipient's inbox" activiti:expression="${mailbox.inbox(recipient)}" activiti:resultVariableName="recipientInbox"/>
    <sequenceFlow id="f_captureRecipient_end" sourceRef="captureRecipient" targetRef="end"/>
    <endEvent id="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="mailErrors">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendStrict_di" bpmnElement="sendStrict">
        <dc:Bounds x="220" y="50" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="afterMail_di" bpmnElement="afterMail">
        <dc:Bounds x="370" y="50" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="captureRecipient_di" bpmnElement="captureRecipient">
        <dc:Bounds x="520" y="50" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="702" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_sendStrict_di" bpmnElement="f_start_sendStrict">
        <di:waypoint x="138" y="90"/>
        <di:waypoint x="220" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sendStrict_afterMail_di" bpmnElement="f_sendStrict_afterMail">
        <di:waypoint x="320" y="90"/>
        <di:waypoint x="370" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_afterMail_captureRecipient_di" bpmnElement="f_afterMail_captureRecipient">
        <di:waypoint x="470" y="90"/>
        <di:waypoint x="520" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_captureRecipient_end_di" bpmnElement="f_captureRecipient_end">
        <di:waypoint x="620" y="90"/>
        <di:waypoint x="702" y="90"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
