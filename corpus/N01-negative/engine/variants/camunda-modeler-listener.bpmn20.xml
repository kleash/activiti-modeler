<?xml version="1.0" encoding="UTF-8"?>
<!-- Variant of engine/variants/camunda-modeler-deployable.bpmn20.xml for the engine checks: the user task also has the task listener of the original
     models/camunda-modeler.bpmn20.xml. Elements are matched by their local name, so camunda:taskListener IS a task listener to the engine. The two service tasks get an activiti:expression next to their
     camunda: attributes, so that the file deploys and one can see what the engine does with everything else that is camunda: (the
     attributes and elements are otherwise the same as in the original, and no activiti: attribute is added to the user task). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:activiti="http://activiti.org/bpmn" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_camunda" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:process id="approval" name="Approval" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="start" name="Request received" camunda:initiator="starter" camunda:formKey="request-form" />
    <bpmn:userTask id="review" name="Review the request" camunda:assignee="${reviewer}" camunda:candidateGroups="managers" camunda:dueDate="${dueDate}" camunda:followUpDate="${followUp}">
      <bpmn:extensionElements>
        <camunda:taskListener event="create" class="com.example.ReviewCreated" />
        <camunda:inputOutput>
          <camunda:inputParameter name="amount">${total}</camunda:inputParameter>
          <camunda:outputParameter name="approved">${decision}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:serviceTask id="archive" name="Archive" activiti:expression="${execution.setVariable('archiveRan', true)}" camunda:class="com.example.ArchiveDelegate" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:resultVariable="archived" />
    <bpmn:serviceTask id="notify" name="Notify" activiti:expression="${execution.setVariable('notifyRan', true)}" camunda:delegateExpression="${notifier}" />
    <bpmn:endEvent id="end" name="Done" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="review" />
    <bpmn:sequenceFlow id="f2" sourceRef="review" targetRef="archive" />
    <bpmn:sequenceFlow id="f3" sourceRef="archive" targetRef="notify" />
    <bpmn:sequenceFlow id="f4" sourceRef="notify" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
