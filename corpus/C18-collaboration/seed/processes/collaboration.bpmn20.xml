<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:activiti="http://activiti.org/bpmn"
             id="Definitions_collaboration"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C18">
  <message id="orderPlacedMsg" name="orderPlaced"/>
  <message id="orderConfirmedMsg" name="orderConfirmed"/>
  <dataStore id="orderDb" name="Order database"/>
  <collaboration id="orderCollaboration">
    <participant id="customerPool" name="Customer" processRef="customerOrder"/>
    <participant id="supplierPool" name="Supplier" processRef="supplierFulfilment"/>
    <participant id="carrierPool" name="Carrier (black box)"/>
    <messageFlow id="mf_orderSent_supplierStart" name="Order" sourceRef="orderSent" targetRef="supplierStart" messageRef="orderPlacedMsg"/>
    <messageFlow id="mf_supplierEnd_awaitConfirmation" name="Confirmation" sourceRef="supplierEnd" targetRef="awaitConfirmation" messageRef="orderConfirmedMsg"/>
    <messageFlow id="mf_shipOrder_carrierPool" name="Parcel" sourceRef="shipOrder" targetRef="carrierPool"/>
  </collaboration>
  <process id="customerOrder" name="Customer order" isExecutable="true">
    <documentation>The customer pool: places an order, sends it to the supplier, waits for the confirmation and approves the delivery. Pools, lanes, message flows, the data store reference and the data object reference are documentation: the engine deploys each pool as its own process and moves no token along a message flow.</documentation>
    <laneSet id="customerLanes">
      <lane id="buyerLane" name="Buyer">
        <flowNodeRef>custStart</flowNodeRef>
        <flowNodeRef>placeOrder</flowNodeRef>
        <flowNodeRef>orderSent</flowNodeRef>
        <flowNodeRef>awaitConfirmation</flowNodeRef>
      </lane>
      <lane id="approverLane" name="Approver">
        <flowNodeRef>approveDelivery</flowNodeRef>
        <flowNodeRef>custEnd</flowNodeRef>
      </lane>
    </laneSet>
    <dataObject id="orderNote" name="orderNote" itemSubjectRef="xsd:string">
      <extensionElements>
        <activiti:value>draft</activiti:value>
      </extensionElements>
    </dataObject>
    <dataObjectReference id="orderNoteRef" name="Order note" dataObjectRef="orderNote"/>
    <dataStoreReference id="orderStore" name="Orders" dataStoreRef="orderDb"/>
    <startEvent id="custStart" name="Need an item"/>
    <sequenceFlow id="f_custStart_placeOrder" sourceRef="custStart" targetRef="placeOrder"/>
    <userTask id="placeOrder" name="Place order" activiti:assignee="ann">
      <dataInputAssociation id="dia_orderNoteRef_placeOrder">
        <sourceRef>orderNoteRef</sourceRef>
        <targetRef>placeOrder</targetRef>
      </dataInputAssociation>
      <dataOutputAssociation id="doa_placeOrder_orderStore">
        <targetRef>orderStore</targetRef>
      </dataOutputAssociation>
    </userTask>
    <sequenceFlow id="f_placeOrder_orderSent" sourceRef="placeOrder" targetRef="orderSent"/>
    <intermediateThrowEvent id="orderSent" name="Order sent">
      <messageEventDefinition messageRef="orderPlacedMsg" activiti:delegateExpression="${recordingThrowMessageDelegate}"/>
    </intermediateThrowEvent>
    <sequenceFlow id="f_orderSent_awaitConfirmation" sourceRef="orderSent" targetRef="awaitConfirmation"/>
    <intermediateCatchEvent id="awaitConfirmation" name="Confirmation arrives">
      <messageEventDefinition messageRef="orderConfirmedMsg" activiti:correlationKey="${orderId}"/>
    </intermediateCatchEvent>
    <sequenceFlow id="f_awaitConfirmation_approveDelivery" sourceRef="awaitConfirmation" targetRef="approveDelivery"/>
    <userTask id="approveDelivery" name="Approve delivery" activiti:assignee="bob"/>
    <sequenceFlow id="f_approveDelivery_custEnd" sourceRef="approveDelivery" targetRef="custEnd"/>
    <endEvent id="custEnd" name="Order done"/>
  </process>
  <process id="supplierFulfilment" name="Supplier fulfilment" isExecutable="true">
    <documentation>The supplier pool: an order message starts it, the stock is reserved, the parcel is shipped and a confirmation message ends it. The pool has no lanes.</documentation>
    <startEvent id="supplierStart" name="Order received">
      <messageEventDefinition messageRef="orderPlacedMsg"/>
    </startEvent>
    <sequenceFlow id="f_supplierStart_reserveStock" sourceRef="supplierStart" targetRef="reserveStock"/>
    <serviceTask id="reserveStock" name="Reserve stock" activiti:expression="${execution.setVariable('reserved', true)}"/>
    <sequenceFlow id="f_reserveStock_shipOrder" sourceRef="reserveStock" targetRef="shipOrder"/>
    <userTask id="shipOrder" name="Ship order" activiti:assignee="ann"/>
    <sequenceFlow id="f_shipOrder_supplierEnd" sourceRef="shipOrder" targetRef="supplierEnd"/>
    <endEvent id="supplierEnd" name="Confirmation sent">
      <messageEventDefinition messageRef="orderConfirmedMsg" activiti:delegateExpression="${recordingThrowMessageDelegate}"/>
    </endEvent>
    <textAnnotation id="shipNote">
      <text>The carrier is a black box pool: nothing is deployed for it.</text>
    </textAnnotation>
    <association id="as_shipOrder_shipNote" sourceRef="shipOrder" targetRef="shipNote" associationDirection="None"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderCollaboration">
      <bpmndi:BPMNShape id="customerPool_di" bpmnElement="customerPool" isHorizontal="true">
