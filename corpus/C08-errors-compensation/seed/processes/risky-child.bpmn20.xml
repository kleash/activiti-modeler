<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             id="Definitions_riskyChild"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C08">
  <error id="childErrorEndError" name="Child error end" errorCode="CHILD_ERROR_END"/>
  <process id="riskyChild" name="Risky child process" isExecutable="true">
    <documentation>Called by mapExceptionCallActivity. The task raises the BpmnError errorCode or the Java exception exceptionClass when asked to (no exceptions are mapped here); a surviving instance ends with an error end event when endWithError is true.</documentation>
    <startEvent id="cStart"/>
    <sequenceFlow id="f_cStart_risky" sourceRef="cStart" targetRef="risky"/>
    <serviceTask id="risky" name="Risky step" activiti:class="io.github.kleash.activiti.harness.support.FailureDelegate">
      <extensionElements>
        <activiti:field name="errorCode">
          <activiti:expression>${execution.getVariable('errorCode')}</activiti:expression>
        </activiti:field>
        <activiti:field name="exceptionClass">
          <activiti:expression>${execution.getVariable('exceptionClass')}</activiti:expression>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f_risky_finishWithError" sourceRef="risky" targetRef="finishWithError"/>
    <exclusiveGateway id="finishWithError" name="End with an error?" default="f_finishWithError_childDone"/>
    <sequenceFlow id="f_finishWithError_childErrorEnd" name="yes" sourceRef="finishWithError" targetRef="childErrorEnd">
      <conditionExpression xsi:type="tFormalExpression">${endWithError == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_finishWithError_childDone" name="no" sourceRef="finishWithError" targetRef="childDone"/>
    <endEvent id="childErrorEnd" name="Child error end">
      <errorEventDefinition errorRef="childErrorEndError"/>
    </endEvent>
    <endEvent id="childDone" name="Child done"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="riskyChild">
      <bpmndi:BPMNShape id="cStart_di" bpmnElement="cStart">
        <dc:Bounds x="102" y="182" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="risky_di" bpmnElement="risky">
        <dc:Bounds x="220" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finishWithError_di" bpmnElement="finishWithError" isMarkerVisible="true">
        <dc:Bounds x="395" y="175" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childErrorEnd_di" bpmnElement="childErrorEnd">
        <dc:Bounds x="552" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="childDone_di" bpmnElement="childDone">
        <dc:Bounds x="552" y="292" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_cStart_risky_di" bpmnElement="f_cStart_risky">
        <di:waypoint x="138" y="200"/>
        <di:waypoint x="220" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_risky_finishWithError_di" bpmnElement="f_risky_finishWithError">
        <di:waypoint x="320" y="200"/>
        <di:waypoint x="395" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_finishWithError_childErrorEnd_di" bpmnElement="f_finishWithError_childErrorEnd">
        <di:waypoint x="445" y="200"/>
        <di:waypoint x="498" y="200"/>
        <di:waypoint x="498" y="90"/>
        <di:waypoint x="552" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_finishWithError_childDone_di" bpmnElement="f_finishWithError_childDone">
        <di:waypoint x="445" y="200"/>
        <di:waypoint x="498" y="200"/>
        <di:waypoint x="498" y="310"/>
        <di:waypoint x="552" y="310"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
