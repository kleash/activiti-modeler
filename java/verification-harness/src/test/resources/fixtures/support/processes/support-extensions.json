{
  "id": "support-extensions",
  "extensions": {
    "support": {
      "properties": {
        "p1": { "id": "p1", "name": "customerId", "type": "string" },
        "p2": { "id": "p2", "name": "customerName", "type": "string" },
        "p3": { "id": "p3", "name": "tier", "type": "string" },
        "p4": { "id": "p4", "name": "found", "type": "boolean" },
        "p5": { "id": "p5", "name": "echoA", "type": "string" },
        "p6": { "id": "p6", "name": "echoB", "type": "string" },
        "p7": { "id": "p7", "name": "echoCount", "type": "integer" }
      },
      "mappings": {
        "crm": {
          "inputs": { "customerId": { "type": "VARIABLE", "value": "customerId" } },
          "outputs": {
            "customerName": { "type": "VARIABLE", "value": "customerName" },
            "tier": { "type": "VARIABLE", "value": "tier" },
            "found": { "type": "VARIABLE", "value": "found" }
          }
        },
        "echo": {
          "inputs": { "a": { "type": "VALUE", "value": "x" }, "b": { "type": "VARIABLE", "value": "customerId" } },
          "outputs": {
            "echoA": { "type": "VARIABLE", "value": "a" },
            "echoB": { "type": "VARIABLE", "value": "b" },
            "echoCount": { "type": "VARIABLE", "value": "echoCount" }
          }
        }
      },
      "constants": {
        "echo": { "c": { "value": 42 } }
      }
    },
    "supportExtras": {
      "mappings": { "flagsEph": { "ephemeral": true } }
    },
    "failingConnector": {
      "mappings": { "fail": { "inputs": { "reason": { "type": "VALUE", "value": "disk full" } } } }
    },
    "bpmnErrorConnector": {
      "mappings": { "err": { "inputs": { "errorCode": { "type": "VALUE", "value": "E42" } } } }
    }
  }
}
