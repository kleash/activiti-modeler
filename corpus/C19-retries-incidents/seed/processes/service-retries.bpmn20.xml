        <di:waypoint x="845" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_retryFive_merge_di" bpmnElement="f_retryFive_merge">
        <di:waypoint x="620" y="200"/>
        <di:waypoint x="732" y="200"/>
        <di:waypoint x="732" y="310"/>
        <di:waypoint x="845" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_retryOnce_merge_di" bpmnElement="f_retryOnce_merge">
        <di:waypoint x="620" y="420"/>
        <di:waypoint x="732" y="420"/>
        <di:waypoint x="732" y="310"/>
        <di:waypoint x="845" y="310"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_retryDefault_merge_di" bpmnElement="f_retryDefault_merge">
        <di:waypoint x="620" y="530"/>
        <di:waypoint x="732" y="530"/>
        <di:waypoint x="732" y="310"/>
