      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipOrder_di" bpmnElement="shipOrder">
        <dc:Bounds x="670" y="380" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="supplierEnd_di" bpmnElement="supplierEnd">
        <dc:Bounds x="852" y="402" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipNote_di" bpmnElement="shipNote">
        <dc:Bounds x="505" y="527" width="130" height="50"/>
