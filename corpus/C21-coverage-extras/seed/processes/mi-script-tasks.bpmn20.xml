<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C21">
  <process id="miScriptTasks" name="Multi-instance script tasks" isExecutable="true">
    <documentation>Multi-instance script tasks: a parallel JUEL script over a collection, a sequential JavaScript script over a collection that also has a result variable (a process variable shared by the rounds) and a parallel JavaScript script driven by a loop cardinality.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_squareEach" sourceRef="start" targetRef="squareEach"/>
    <scriptTask id="squareEach" name="Square each number" scriptFormat="juel">
      <multiInstanceLoopCharacteristics isSequential="false" activiti:collection="numbers" activiti:elementVariable="n" activiti:elementIndexVariable="pos">
        <loopDataOutputRef>squares</loopDataOutputRef>
        <outputDataItem name="square"/>
      </multiInstanceLoopCharacteristics>
      <script>${execution.setVariableLocal('square', n * n)}</script>
    </scriptTask>
    <sequenceFlow id="f_squareEach_runningTotal" sourceRef="squareEach" targetRef="runningTotal"/>
    <scriptTask id="runningTotal" name="Add up in turn" scriptFormat="javascript" activiti:resultVariable="running">
      <multiInstanceLoopCharacteristics isSequential="true" activiti:collection="numbers" activiti:elementVariable="n" activiti:elementIndexVariable="step">
        <loopDataOutputRef>trails</loopDataOutputRef>
        <outputDataItem name="trail"/>
      </multiInstanceLoopCharacteristics>
      <script>var before = execution.getVariable('running');
var total = (before == null ? 0 : before) + n;
execution.setVariableLocal('trail', step + ':' + total);
total;</script>
    </scriptTask>
    <sequenceFlow id="f_runningTotal_cubeEach" sourceRef="runningTotal" targetRef="cubeEach"/>
    <scriptTask id="cubeEach" name="Cube each round" scriptFormat="javascript">
      <multiInstanceLoopCharacteristics isSequential="false" activiti:elementIndexVariable="round">
        <loopCardinality>${rounds}</loopCardinality>
        <loopDataOutputRef>cubes</loopDataOutputRef>
        <outputDataItem name="cube"/>
      </multiInstanceLoopCharacteristics>
      <script>execution.setVariableLocal('cube', round * round * round);</script>
    </scriptTask>
    <sequenceFlow id="f_cubeEach_end" sourceRef="cubeEach" targetRef="end"/>
    <endEvent id="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="miScriptTasks">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="squareEach_di" bpmnElement="squareEach">
        <dc:Bounds x="220" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="runningTotal_di" bpmnElement="runningTotal">
        <dc:Bounds x="370" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cubeEach_di" bpmnElement="cubeEach">
        <dc:Bounds x="520" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="702" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_squareEach_di" bpmnElement="f_start_squareEach">
        <di:waypoint x="138" y="110"/>
        <di:waypoint x="220" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_squareEach_runningTotal_di" bpmnElement="f_squareEach_runningTotal">
        <di:waypoint x="320" y="110"/>
        <di:waypoint x="370" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_runningTotal_cubeEach_di" bpmnElement="f_runningTotal_cubeEach">
        <di:waypoint x="470" y="110"/>
        <di:waypoint x="520" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_cubeEach_end_di" bpmnElement="f_cubeEach_end">
        <di:waypoint x="620" y="110"/>
        <di:waypoint x="702" y="110"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
