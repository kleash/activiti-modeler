<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:activiti="http://activiti.org/bpmn" xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://example.org/lab">

  <process id="t33_compensation" name="t33_compensation" isExecutable="true">
    <startEvent id="s"/><serviceTask id="a" activiti:expression="${execution.setVariable('a','done')}"/>
    <boundaryEvent id="cb" attachedToRef="a"><compensateEventDefinition/></boundaryEvent>
    <serviceTask id="undoA" isForCompensation="true" activiti:expression="${execution.setVariable('undone','yes')}"/>
    <intermediateThrowEvent id="th"><compensateEventDefinition/></intermediateThrowEvent>
    <userTask id="u"/><endEvent id="e"/>
    <sequenceFlow id="f1" sourceRef="s" targetRef="a"/>
    <sequenceFlow id="f2" sourceRef="a" targetRef="th"/>
    <sequenceFlow id="f3" sourceRef="th" targetRef="u"/>
    <sequenceFlow id="f4" sourceRef="u" targetRef="e"/>
    <association id="as" associationDirection="One" sourceRef="cb" targetRef="undoA"/>

  </process>
</definitions>
