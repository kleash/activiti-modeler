        <dc:Bounds x="40" y="155" width="1188" height="122"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="supplierPool_di" bpmnElement="supplierPool" isHorizontal="true">
        <dc:Bounds x="10" y="350" width="1218" height="257"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carrierPool_di" bpmnElement="carrierPool" isHorizontal="true">
        <dc:Bounds x="10" y="647" width="1218" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="orderNoteRef_di" bpmnElement="orderNoteRef">
        <dc:Bounds x="102" y="175" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="orderStore_di" bpmnElement="orderStore">
        <dc:Bounds x="245" y="197" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="custStart_di" bpmnElement="custStart">
        <dc:Bounds x="102" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="placeOrder_di" bpmnElement="placeOrder">
        <dc:Bounds x="220" y="50" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="orderSent_di" bpmnElement="orderSent">
        <dc:Bounds x="402" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="awaitConfirmation_di" bpmnElement="awaitConfirmation">
        <dc:Bounds x="852" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approveDelivery_di" bpmnElement="approveDelivery">
        <dc:Bounds x="970" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="custEnd_di" bpmnElement="custEnd">
