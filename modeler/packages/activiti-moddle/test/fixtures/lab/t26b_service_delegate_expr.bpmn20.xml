<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:activiti="http://activiti.org/bpmn" xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://example.org/lab">

  <process id="t26b_service_delegate_expr" name="t26b_service_delegate_expr" isExecutable="true">
    <startEvent id="s"/>
    <serviceTask id="svc" activiti:delegateExpression="${labDelegate}"/>
    <userTask id="u"/>
    <endEvent id="e"/>
    <sequenceFlow id="f_s_svc" sourceRef="s" targetRef="svc"/>
    <sequenceFlow id="f_svc_u" sourceRef="svc" targetRef="u"/>
    <sequenceFlow id="f_u_e" sourceRef="u" targetRef="e"/>

  </process>
</definitions>
