      <sequenceFlow id="f_inTask_prepareEnd" sourceRef="inTask" targetRef="prepareEnd"/>
      <endEvent id="prepareEnd"/>
    </subProcess>
    <sequenceFlow id="f_prepare_end" sourceRef="prepare" targetRef="end"/>
    <endEvent id="end"/>
  </process>
