{
  "id": "task-mappings-extensions",
  "extensions": {
    "taskMappings": {
      "properties": {
        "p1": { "id": "p1", "name": "customerId", "type": "string" },
        "p2": { "id": "p2", "name": "amount", "type": "integer" },
        "p3": { "id": "p3", "name": "approved", "type": "boolean" },
        "p4": { "id": "p4", "name": "reviewerComment", "type": "string" },
        "p5": { "id": "p5", "name": "stamp", "type": "string" },
        "p6": { "id": "p6", "name": "completedBy", "type": "string" }
      },
      "mappings": {
        "approve": {
          "inputs": {
            "amount": { "type": "VARIABLE", "value": "amount" },
            "currency": { "type": "VALUE", "value": "EUR" },
            "who": { "type": "VALUE", "value": "${customerId}" },
            "label": { "type": "VALUE", "value": "Loan of ${customerId}" }
          },
          "outputs": {
            "approved": { "type": "VARIABLE", "value": "approved" },
            "reviewerComment": { "type": "VARIABLE", "value": "comment" },
            "stamp": { "type": "VALUE", "value": "reviewed" },
            "completedBy": { "type": "VARIABLE", "value": "sys_task_assignee" }
          }
        },
        "passAll": { "mappingType": "MAP_ALL" }
      },
      "constants": {
        "approve": { "limit": { "value": 1000 } }
      }
    }
  }
}
