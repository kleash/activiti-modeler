        <di:waypoint x="438" y="200"/>
        <di:waypoint x="552" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_waitMessage_messageSeen_di" bpmnElement="f_waitMessage_messageSeen">
        <di:waypoint x="438" y="310"/>
