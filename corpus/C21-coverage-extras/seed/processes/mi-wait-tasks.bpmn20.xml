<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C21">
  <process id="miWaitTasks" name="Multi-instance manual and receive tasks" isExecutable="true">
    <documentation>A parallel multi-instance manual task, which passes straight through once per parcel, and a parallel multi-instance receive task, where every parcel waits for its own trigger. Each loop collects its element variable (outputDataItem) into a list (loopDataOutputRef) in the order the instances complete.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_packEach" sourceRef="start" targetRef="packEach"/>
    <manualTask id="packEach" name="Pack each parcel">
      <multiInstanceLoopCharacteristics isSequential="false" activiti:collection="parcels" activiti:elementVariable="parcel">
        <loopDataOutputRef>packed</loopDataOutputRef>
        <outputDataItem name="parcel"/>
      </multiInstanceLoopCharacteristics>
    </manualTask>
    <sequenceFlow id="f_packEach_pickUpEach" sourceRef="packEach" targetRef="pickUpEach"/>
    <receiveTask id="pickUpEach" name="Wait until each parcel is picked up">
      <multiInstanceLoopCharacteristics isSequential="false" activiti:collection="parcels" activiti:elementVariable="parcel">
        <loopDataOutputRef>pickedUp</loopDataOutputRef>
        <outputDataItem name="parcel"/>
      </multiInstanceLoopCharacteristics>
    </receiveTask>
    <sequenceFlow id="f_pickUpEach_end" sourceRef="pickUpEach" targetRef="end"/>
    <endEvent id="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="miWaitTasks">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="packEach_di" bpmnElement="packEach">
        <dc:Bounds x="220" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pickUpEach_di" bpmnElement="pickUpEach">
        <dc:Bounds x="370" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="552" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_packEach_di" bpmnElement="f_start_packEach">
        <di:waypoint x="138" y="110"/>
        <di:waypoint x="220" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_packEach_pickUpEach_di" bpmnElement="f_packEach_pickUpEach">
        <di:waypoint x="320" y="110"/>
        <di:waypoint x="370" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_pickUpEach_end_di" bpmnElement="f_pickUpEach_end">
        <di:waypoint x="470" y="110"/>
        <di:waypoint x="552" y="110"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
