    <userTask id="outsideTask" name="Outside work" activiti:candidateUsers="cy"/>
    <sequenceFlow id="f_outsideTask_joinMain" sourceRef="outsideTask" targetRef="joinMain"/>
    <parallelGateway id="joinMain" name="Join"/>
    <sequenceFlow id="f_joinMain_afterJoin" sourceRef="joinMain" targetRef="afterJoin"/>
    <userTask id="afterJoin" name="After the join" activiti:candidateUsers="ann"/>
    <sequenceFlow id="f_afterJoin_end" sourceRef="afterJoin" targetRef="end"/>
    <endEvent id="end"/>
