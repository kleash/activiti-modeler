        <di:waypoint x="588" y="330"/>
        <di:waypoint x="642" y="330"/>
        <di:waypoint x="642" y="220"/>
        <di:waypoint x="695" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_join_end_di" bpmnElement="f_join_end">
