# The Java runtime of the Docker image: Eclipse Temurin 25 JDK, the Alpine Linux (musl) build, pinned by version and by SHA-256.
# The Dockerfile sources this file (POSIX sh syntax), downloads the archive from the Adoptium API
# (https://api.adoptium.net/v3/binary/version/jdk-<version>/alpine-linux/<arch>/jdk/hotspot/normal/eclipse), refuses it unless the SHA-256 matches,
# and links the trimmed runtime of the image from it (scripts/build-runtime.sh). The checksums are the ones the Adoptium API publishes
# (https://api.adoptium.net/v3/assets/latest/25/hotspot?os=alpine-linux&image_type=jdk&architecture=<x64|aarch64>&vendor=eclipse).
#
# To move to a newer Temurin 25 build (a Dependabot-like update does not exist for this file):
#   scripts/update-jdk-alpine.sh --write      rewrites this file from the Adoptium API (both architectures)
#   then build the image, run scripts/smoke-docker.sh and scripts/cve-scan.sh --skip-java --skip-npm --image <image>, and open a pull request.
# scripts/update-jdk-alpine.sh (no option) only reports; the release workflow runs it and prints a warning when a newer build exists.
TEMURIN_VERSION=25.0.5+8
TEMURIN_SHA256_X64=efc86581260b73c340c313e7577c4c85d6a8a899edc3748d78bee5238fe44a4e
TEMURIN_SHA256_AARCH64=d02eadc0a0f93faba4be38c8657eb8eef842103a4c7c2400f5827dbd90fc21c9
