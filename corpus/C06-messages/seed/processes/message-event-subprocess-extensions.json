{
  "id": "message-event-subprocess-extensions",
  "extensions": {
    "messageEventSubprocess": {
      "properties": {
        "p1": { "id": "p1", "name": "orderId", "type": "string" },
        "p2": { "id": "p2", "name": "lastNote", "type": "string" },
        "p3": { "id": "p3", "name": "reason", "type": "string" }
      },
      "mappings": {
        "escalateStart": { "outputs": { "reason": { "type": "VARIABLE", "value": "why" } } },
        "noteStart": { "outputs": { "lastNote": { "type": "VARIABLE", "value": "text" } } }
      }
    }
  }
}
