<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.kleash.activiti</groupId>
    <artifactId>activiti-modeler-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>activiti-scenario-runner</artifactId>
  <name>Activiti scenario runner</name>
  <description>Runs data-driven scenarios (inputs, steps, expected path and outputs) against embedded Activiti.</description>

  <dependencies>
    <dependency>
      <groupId>org.activiti</groupId>
      <artifactId>activiti-spring-boot-starter</artifactId>
    </dependency>
    <!-- The starter declares these as optional: security (ProcessRuntime/TaskRuntime), JSON (extensions reader), JDBC. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Validates scenario files against schemas/scenario.schema.json (JSON Schema 2020-12). 2.x is built on Jackson 2. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The JSON Schemas at the repository root are the single source of truth; the library ships them. -->
      <resource>
        <directory>${project.basedir}/../../schemas</directory>
        <targetPath>schemas</targetPath>
        <includes>
          <include>scenario.schema.json</include>
          <include>model-expect.schema.json</include>
          <include>coverage-exemptions.schema.json</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
