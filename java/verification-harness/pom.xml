<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.kleash.activiti</groupId>
    <artifactId>activiti-modeler-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>verification-harness</artifactId>
  <name>Verification harness</name>
  <description>Deploys and runs corpus projects (seed or modeler-generated, or any folder) on embedded Activiti 9.0.0: one Spring context and one H2 database per project.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.kleash.activiti</groupId>
      <artifactId>activiti-scenario-runner</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- DMN: decision tasks (dmn-connector.EXECUTE_TABLE), the runner's decisions[] section, and the Operaton/KIE cross-check -->
    <dependency>
      <groupId>io.github.kleash.activiti</groupId>
      <artifactId>activiti-dmn-connector</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.kleash.activiti</groupId>
      <artifactId>activiti-dmn-connector-kie</artifactId>
    </dependency>
    <dependency>
      <groupId>org.activiti</groupId>
      <artifactId>activiti-spring-boot-starter</artifactId>
    </dependency>
    <!-- The starter declares these as optional: security (ProcessRuntime/TaskRuntime), JSON (extensions reader), JDBC. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Mail server for the mail corpus (C14), started only for projects whose harness.properties say harness.greenmail=true.
         GreenMail declares JUnit 4 as a compile dependency for its rules; the harness does not use them. -->
    <dependency>
      <groupId>com.icegreen</groupId>
      <artifactId>greenmail</artifactId>
      <version>${greenmail.version}</version>
      <exclusions>
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <properties>
    <greenmail.version>2.1.3</greenmail.version>
  </properties>

  <build>
    <plugins>
      <!-- mvn -f java/pom.xml -pl verification-harness exec:java -Dexec.args=<dir>   (see also scripts/verify-models.sh) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <mainClass>io.github.kleash.activiti.harness.VerifyCli</mainClass>
          <classpathScope>runtime</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
