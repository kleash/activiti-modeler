<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             id="Definitions_compensationTargets"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C08">
  <process id="compensationTargets" name="Targeted compensation" isExecutable="true">
    <documentation>Two compensable service tasks and four ways to leave: broadcast (no activityRef, waitForCompletion false), activityRef naming the compensation handler, activityRef naming the compensated task, or no compensation. In Activiti 9.0.0 the compensation subscription is keyed by the id of the handler, so only the handler id compensates; the id of the compensated task finds nothing and the throw event passes silently. waitForCompletion is parsed but not honoured: the handlers always finish before the process moves on.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_bookFlight" sourceRef="start" targetRef="bookFlight"/>
    <serviceTask id="bookFlight" name="Book flight" activiti:expression="${execution.setVariable('flightBooked', true)}"/>
    <boundaryEvent id="onFlightCompensate" name="Compensate flight" attachedToRef="bookFlight">
      <compensateEventDefinition/>
    </boundaryEvent>
    <sequenceFlow id="f_bookFlight_bookHotel" sourceRef="bookFlight" targetRef="bookHotel"/>
    <serviceTask id="bookHotel" name="Book hotel" activiti:expression="${execution.setVariable('hotelBooked', true)}"/>
    <boundaryEvent id="onHotelCompensate" name="Compensate hotel" attachedToRef="bookHotel">
      <compensateEventDefinition/>
    </boundaryEvent>
    <sequenceFlow id="f_bookHotel_target" sourceRef="bookHotel" targetRef="target"/>
    <exclusiveGateway id="target" name="What to compensate?" default="f_target_nothing"/>
    <sequenceFlow id="f_target_throwAll" name="all" sourceRef="target" targetRef="throwAll">
      <conditionExpression xsi:type="tFormalExpression">${compensateWhat == 'all'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_target_throwHandler" name="flight handler" sourceRef="target" targetRef="throwHandler">
      <conditionExpression xsi:type="tFormalExpression">${compensateWhat == 'handler'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_target_throwTask" name="flight task" sourceRef="target" targetRef="throwTask">
      <conditionExpression xsi:type="tFormalExpression">${compensateWhat == 'task'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_target_nothing" name="nothing" sourceRef="target" targetRef="nothing"/>
    <intermediateThrowEvent id="throwAll" name="Compensate everything">
      <compensateEventDefinition waitForCompletion="false"/>
    </intermediateThrowEvent>
    <sequenceFlow id="f_throwAll_allDone" sourceRef="throwAll" targetRef="allDone"/>
    <endEvent id="allDone" name="All compensated"/>
    <intermediateThrowEvent id="throwHandler" name="Compensate by handler id">
      <compensateEventDefinition activityRef="cancelFlight"/>
    </intermediateThrowEvent>
    <sequenceFlow id="f_throwHandler_handlerDone" sourceRef="throwHandler" targetRef="handlerDone"/>
    <endEvent id="handlerDone" name="Handler compensated"/>
    <intermediateThrowEvent id="throwTask" name="Compensate by task id">
      <compensateEventDefinition activityRef="bookFlight"/>
    </intermediateThrowEvent>
    <sequenceFlow id="f_throwTask_taskDone" sourceRef="throwTask" targetRef="taskDone"/>
    <endEvent id="taskDone" name="Task id passed"/>
    <endEvent id="nothing" name="Nothing compensated"/>
    <serviceTask id="cancelFlight" name="Cancel flight" isForCompensation="true" activiti:delegateExpression="${recordingDelegate}"/>
    <serviceTask id="cancelHotel" name="Cancel hotel" isForCompensation="true" activiti:delegateExpression="${recordingDelegate}"/>
    <association id="a_onFlightCompensate_cancelFlight" associationDirection="One" sourceRef="onFlightCompensate" targetRef="cancelFlight"/>
    <association id="a_onHotelCompensate_cancelHotel" associationDirection="One" sourceRef="onHotelCompensate" targetRef="cancelHotel"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="compensationTargets">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
