             xmlns:activiti="http://activiti.org/bpmn"
             id="Definitions_bookingTransaction"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C09">
  <process id="bookingTransaction" name="Booking transaction" isExecutable="true">
    <documentation>A transaction sub process with compensable work. When the payment fails, the cancel end event cancels the transaction: the completed compensable activities are compensated (handlers in reverse order of completion) and the process leaves through the cancel boundary event instead of the normal flow. A cancel end event can only do this when at least one compensable activity of the transaction has completed; without one the engine fails with "No execution found for sub process of boundary cancel event" and the completion is rolled back.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_booking" sourceRef="start" targetRef="booking"/>
    <transaction id="booking" name="Book and pay">
      <startEvent id="tStart"/>
      <sequenceFlow id="f_tStart_reserveGate" sourceRef="tStart" targetRef="reserveGate"/>
      <exclusiveGateway id="reserveGate" name="Reserve first?" default="f_reserveGate_pay"/>
      <sequenceFlow id="f_reserveGate_reserveSeat" name="yes" sourceRef="reserveGate" targetRef="reserveSeat">
        <conditionExpression xsi:type="tFormalExpression">${reserve == true}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="f_reserveGate_pay" name="no" sourceRef="reserveGate" targetRef="pay"/>
      <userTask id="reserveSeat" name="Reserve seat" activiti:assignee="ann"/>
      <boundaryEvent id="onSeatCompensate" name="Compensate seat" attachedToRef="reserveSeat">
        <compensateEventDefinition/>
      </boundaryEvent>
      <sequenceFlow id="f_reserveSeat_reserveMeal" sourceRef="reserveSeat" targetRef="reserveMeal"/>
      <userTask id="reserveMeal" name="Reserve meal" activiti:assignee="ann"/>
      <boundaryEvent id="onMealCompensate" name="Compensate meal" attachedToRef="reserveMeal">
        <compensateEventDefinition/>
      </boundaryEvent>
      <sequenceFlow id="f_reserveMeal_pay" sourceRef="reserveMeal" targetRef="pay"/>
      <userTask id="pay" name="Take payment" activiti:assignee="ann"/>
      <sequenceFlow id="f_pay_paymentCheck" sourceRef="pay" targetRef="paymentCheck"/>
      <exclusiveGateway id="paymentCheck" name="Paid?" default="f_paymentCheck_cancelEnd"/>
      <sequenceFlow id="f_paymentCheck_tEnd" name="yes" sourceRef="paymentCheck" targetRef="tEnd">
        <conditionExpression xsi:type="tFormalExpression">${paid == true}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="f_paymentCheck_cancelEnd" name="no" sourceRef="paymentCheck" targetRef="cancelEnd"/>
      <endEvent id="tEnd" name="Paid"/>
      <endEvent id="cancelEnd" name="Cancel the transaction">
        <cancelEventDefinition/>
      </endEvent>
      <serviceTask id="releaseSeat" name="Release seat" isForCompensation="true" activiti:delegateExpression="${recordingDelegate}"/>
      <serviceTask id="releaseMeal" name="Release meal" isForCompensation="true" activiti:delegateExpression="${recordingDelegate}"/>
      <association id="a_onSeatCompensate_releaseSeat" associationDirection="One" sourceRef="onSeatCompensate" targetRef="releaseSeat"/>
      <association id="a_onMealCompensate_releaseMeal" associationDirection="One" sourceRef="onMealCompensate" targetRef="releaseMeal"/>
    </transaction>
    <sequenceFlow id="f_booking_confirmed" sourceRef="booking" targetRef="confirmed"/>
    <endEvent id="confirmed" name="Confirmed"/>
    <boundaryEvent id="onCancel" name="Cancelled" attachedToRef="booking">
      <cancelEventDefinition/>
    </boundaryEvent>
    <sequenceFlow id="f_onCancel_refund" sourceRef="onCancel" targetRef="refund"/>
    <serviceTask id="refund" name="Refund" activiti:expression="${execution.setVariable('status', 'refunded')}"/>
    <sequenceFlow id="f_refund_cancelled" sourceRef="refund" targetRef="cancelled"/>
    <endEvent id="cancelled" name="Cancelled"/>
  </process>
