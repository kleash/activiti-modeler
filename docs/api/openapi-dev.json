  "info" : {
    "description" : "Development-only endpoints, registered with activiti.rest.dev.enabled=true and open to the admin access level only: validate a project (with a trial deployment into a scratch engine), deploy it, run scenarios against it on the running engine, evaluate decisions, and read and write the project files of the workspace folder.",
    "title" : "Activiti runtime REST (dev)",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/dev/decisions/evaluate" : {
      "post" : {
        "operationId" : "devEvaluateDecision",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DecisionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DecisionOutcome"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Evaluate a decision of an uploaded DMN document or of a deployment: result rows and matched rule ids",
        "tags" : [ "Dev" ]
      }
    },
    "/api/dev/deployments" : {
      "post" : {
        "operationId" : "devDeploy",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DeployRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DeployResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Deploy the files as one deployment, with their names as given; refused with 422 and the findings when the project has errors",
        "tags" : [ "Dev" ]
      }
    },
    "/api/dev/deployments/{id}" : {
      "delete" : {
        "operationId" : "devDeleteDeployment",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "cascade",
          "required" : false,
          "schema" : {
            "default" : true,
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Delete a deployment with its instances, jobs and history",
        "tags" : [ "Dev" ]
      }
    },
    "/api/dev/scenarios/run" : {
      "post" : {
        "operationId" : "devRunScenario",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ScenarioRunRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ScenarioRunResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Run a scenario file against the files, on the running engine in EXECUTOR mode; the files are deployed for the run and removed afterwards",
        "tags" : [ "Dev" ]
      }
    },
    "/api/dev/validate" : {
      "post" : {
        "operationId" : "devValidate",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ValidateRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ValidateResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Check a project: BPMN XSD, RepositoryService.validateProcess, a trial deployment into a scratch engine, a dry load of the extensions JSON, a DMN parse",
        "tags" : [ "Dev" ]
      }
    },
    "/api/dev/workspace" : {
      "get" : {
        "operationId" : "devWorkspaceRoot",
        "parameters" : [ {
          "in" : "query",
          "name" : "recursive",
          "required" : false,
          "schema" : {
            "default" : false,
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkspaceListing"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "The root of the workspace: JSON listing (recursive=true for the whole tree)",
        "tags" : [ "Workspace" ]
      }
    },
    "/api/dev/workspace/{path}" : {
      "delete" : {
        "operationId" : "devWorkspaceDelete",
        "parameters" : [ {
          "in" : "path",
          "name" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "recursive",
          "required" : false,
          "schema" : {
            "default" : false,
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Delete a file, or a directory (empty, or with recursive=true)",
        "tags" : [ "Workspace" ]
      },
      "get" : {
        "operationId" : "devWorkspaceGet",
        "parameters" : [ {
          "in" : "path",
          "name" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "recursive",
          "required" : false,
          "schema" : {
            "default" : false,
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "A directory (JSON listing; recursive=true for the whole tree) or the content of a file",
        "tags" : [ "Workspace" ]
      },
      "put" : {
        "operationId" : "devWorkspacePut",
        "parameters" : [ {
          "in" : "path",
          "name" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "format" : "byte",
                "type" : "string"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "summary" : "Create or replace a file with the request body (atomically); parent directories are created",
        "tags" : [ "Workspace" ]
      }
    }
  },
  "tags" : [ {
    "description" : "Project files on disk (modeler.workspace.dir): list, read, write, delete",
    "name" : "Workspace"
  }, {
    "description" : "Development-only endpoints (activiti.rest.dev.enabled=true): validate, deploy, run scenarios, evaluate decisions, workspace files",
    "name" : "Dev"
  } ]
}
