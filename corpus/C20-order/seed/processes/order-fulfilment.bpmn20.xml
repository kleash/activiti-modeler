      <bpmndi:BPMNShape id="packOrder_di" bpmnElement="packOrder">
        <dc:Bounds x="820" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createShipment_di" bpmnElement="createShipment">
        <dc:Bounds x="820" y="290" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="join_di" bpmnElement="join">
        <dc:Bounds x="995" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="awaitPickup_di" bpmnElement="awaitPickup">
