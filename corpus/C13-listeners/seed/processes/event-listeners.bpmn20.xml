      <bpmndi:BPMNShape id="triggered_di" bpmnElement="triggered">
        <dc:Bounds x="552" y="402" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_fork_di" bpmnElement="f_start_fork">
        <di:waypoint x="138" y="200"/>
