<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="drd" name="drd" namespace="http://activiti.org/schema/1.0/dmn">
  <decision id="risk" name="Risk">
    <variable id="v_risk" name="risk" typeRef="string"/>
    <decisionTable id="dt_risk" hitPolicy="FIRST">
      <input id="i1" label="Age"><inputExpression id="ie1" typeRef="integer"><text>age</text></inputExpression></input>
      <input id="i2" label="Country"><inputExpression id="ie2" typeRef="string"><text>country</text></inputExpression></input>
      <output id="o1" name="risk" typeRef="string"/>
      <rule id="r1"><inputEntry id="r1i1"><text>&lt; 18</text></inputEntry><inputEntry id="r1i2"><text>-</text></inputEntry><outputEntry id="r1o1"><text>"HIGH"</text></outputEntry></rule>
      <rule id="r2"><inputEntry id="r2i1"><text>[18..65]</text></inputEntry><inputEntry id="r2i2"><text>"US","CA"</text></inputEntry><outputEntry id="r2o1"><text>"LOW"</text></outputEntry></rule>
      <rule id="r3"><inputEntry id="r3i1"><text>&gt; 65</text></inputEntry><inputEntry id="r3i2"><text>not("US")</text></inputEntry><outputEntry id="r3o1"><text>"MEDIUM"</text></outputEntry></rule>
      <rule id="r4"><inputEntry id="r4i1"><text></text></inputEntry><inputEntry id="r4i2"><text></text></inputEntry><outputEntry id="r4o1"><text>"MEDIUM"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="offer" name="Offer">
    <variable id="v_offer" name="offer" typeRef="string"/>
    <informationRequirement id="ir1"><requiredDecision href="#risk"/></informationRequirement>
    <decisionTable id="dt_offer" hitPolicy="UNIQUE">
      <input id="j1" label="Risk"><inputExpression id="je1" typeRef="string"><text>risk</text></inputExpression></input>
      <output id="p1" name="offer" typeRef="string"/>
      <rule id="s1"><inputEntry id="s1i"><text>"LOW"</text></inputEntry><outputEntry id="s1o"><text>"GOLD"</text></outputEntry></rule>
      <rule id="s2"><inputEntry id="s2i"><text>"MEDIUM","HIGH"</text></inputEntry><outputEntry id="s2o"><text>"BASIC"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="fee" name="Fee">
    <variable id="v_fee" name="fee" typeRef="number"/>
    <informationRequirement id="ir2"><requiredDecision href="#risk"/></informationRequirement>
    <literalExpression id="le1" typeRef="number"><text>if risk = "LOW" then amount * 0.01 else amount * 0.05</text></literalExpression>
  </decision>
</definitions>
