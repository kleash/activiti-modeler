             targetNamespace="http://activiti.org/bpmn/corpus/C04">
  <process id="parallelForkJoin" name="Parallel fork and join" isExecutable="true">
    <documentation>Parallel gateway: all three branches run; the join waits for every incoming flow.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_fork" sourceRef="start" targetRef="fork"/>
    <parallelGateway id="fork" name="Fork"/>
    <sequenceFlow id="f_fork_taskA" sourceRef="fork" targetRef="taskA"/>
    <sequenceFlow id="f_fork_taskB" sourceRef="fork" targetRef="taskB"/>
    <sequenceFlow id="f_fork_taskC" sourceRef="fork" targetRef="taskC"/>
    <userTask id="taskA" name="Branch A" activiti:candidateUsers="ann"/>
    <userTask id="taskB" name="Branch B" activiti:candidateUsers="ben"/>
    <userTask id="taskC" name="Branch C" activiti:candidateUsers="cy"/>
    <sequenceFlow id="f_taskA_join" sourceRef="taskA" targetRef="join"/>
    <sequenceFlow id="f_taskB_join" sourceRef="taskB" targetRef="join"/>
    <sequenceFlow id="f_taskC_join" sourceRef="taskC" targetRef="join"/>
    <parallelGateway id="join" name="Join"/>
    <sequenceFlow id="f_join_afterJoin" sourceRef="join" targetRef="afterJoin"/>
    <userTask id="afterJoin" name="After the join" activiti:candidateUsers="ann"/>
    <sequenceFlow id="f_afterJoin_end" sourceRef="afterJoin" targetRef="end"/>
    <endEvent id="end"/>
  </process>
