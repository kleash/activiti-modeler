      <bpmndi:BPMNEdge id="f_afterJoin_end_di" bpmnElement="f_afterJoin_end">
        <di:waypoint x="770" y="220"/>
        <di:waypoint x="852" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
