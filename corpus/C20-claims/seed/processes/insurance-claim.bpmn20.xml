      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="payout_di" bpmnElement="payout">
        <dc:Bounds x="820" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="paidEnd_di" bpmnElement="paidEnd">
        <dc:Bounds x="1002" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="recordWithdrawal_di" bpmnElement="recordWithdrawal">
        <dc:Bounds x="520" y="400" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="withdrawnEnd_di" bpmnElement="withdrawnEnd">
        <dc:Bounds x="702" y="422" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="documentStart_di" bpmnElement="documentStart">
        <dc:Bounds x="252" y="642" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="logDocument_di" bpmnElement="logDocument">
        <dc:Bounds x="370" y="620" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="documentLoggedEnd_di" bpmnElement="documentLoggedEnd">
        <dc:Bounds x="552" y="642" width="36" height="36"/>
      </bpmndi:BPMNShape>
