<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_pricing"
             targetNamespace="http://kleash.github.io/corpus/C17-kie">
  <process id="pricing" name="Pricing with a business knowledge model" isExecutable="true">
    <startEvent id="start" name="Start" />
    <serviceTask id="decidePrice" name="Decide price" implementation="dmn-connector.EXECUTE_TABLE" />
    <endEvent id="end" name="End" />
    <sequenceFlow id="flow_start_decidePrice" sourceRef="start" targetRef="decidePrice" />
    <sequenceFlow id="flow_decidePrice_end" sourceRef="decidePrice" targetRef="end" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pricing">
    <bpmndi:BPMNPlane id="BPMNPlane_pricing" bpmnElement="pricing">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="40" y="120" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="13" y="160" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decidePrice_di" bpmnElement="decidePrice">
        <dc:Bounds x="130" y="103" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="330" y="120" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="303" y="160" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_decidePrice_di" bpmnElement="flow_start_decidePrice">
        <di:waypoint x="76" y="138" />
        <di:waypoint x="130" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_decidePrice_end_di" bpmnElement="flow_decidePrice_end">
        <di:waypoint x="260" y="138" />
        <di:waypoint x="330" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
