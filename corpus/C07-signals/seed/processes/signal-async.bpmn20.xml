  <signal id="asyncPingSignal" name="asyncPing"/>
  <process id="signalAsync" name="Asynchronous signal throw" isExecutable="true">
    <documentation>The throw event has activiti:async=true: the catch event is not triggered by the throw itself but by a job, which needs the async executor (or the runner's executeJobs).</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_fork" sourceRef="start" targetRef="fork"/>
    <parallelGateway id="fork"/>
    <sequenceFlow id="f_fork_waitAsync" sourceRef="fork" targetRef="waitAsync"/>
    <sequenceFlow id="f_fork_raiseAsync" sourceRef="fork" targetRef="raiseAsync"/>
    <intermediateCatchEvent id="waitAsync" name="Async ping">
      <signalEventDefinition signalRef="asyncPingSignal"/>
    </intermediateCatchEvent>
    <intermediateThrowEvent id="raiseAsync" name="Raise async ping">
      <signalEventDefinition signalRef="asyncPingSignal" activiti:async="true"/>
    </intermediateThrowEvent>
    <sequenceFlow id="f_waitAsync_join" sourceRef="waitAsync" targetRef="join"/>
    <sequenceFlow id="f_raiseAsync_join" sourceRef="raiseAsync" targetRef="join"/>
    <parallelGateway id="join"/>
    <sequenceFlow id="f_join_end" sourceRef="join" targetRef="end"/>
    <endEvent id="end"/>
  </process>
