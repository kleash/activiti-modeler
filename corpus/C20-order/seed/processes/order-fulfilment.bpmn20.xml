<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             id="Definitions_orderFulfilment"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C20">
  <error id="paymentDeclinedError" name="Payment declined" errorCode="PAYMENT_DECLINED"/>
  <signal id="carrierPickedUpSignal" name="carrierPickedUp"/>
  <signal id="orderDeliveredSignal" name="orderDelivered"/>
  <process id="orderFulfilment" name="Order fulfilment" isExecutable="true">
    <documentation>A web shop order. Connector tasks (applied from the connector templates, which create their mappings) look up the customer, reserve the stock and charge the card. A declined card raises the PAYMENT_DECLINED error: the error boundary event compensates the stock reservation and cancels the order. Otherwise the shipment is prepared in parallel (packing and the shipping label) and the order waits for two signals: carrierPickedUp, whose payload (the carrier) decides the notice that is sent, and orderDelivered. Neither signal catch event has a mapping: on Activiti 9.0.0 the payload of a signal reaches the process without one.</documentation>
    <startEvent id="start" name="Order received"/>
    <sequenceFlow id="f_start_lookupCustomer" sourceRef="start" targetRef="lookupCustomer"/>
    <serviceTask id="lookupCustomer" name="Look up the customer" implementation="crm.LOOKUP" activiti:templateId="crm.LOOKUP" activiti:templateVersion="1"/>
    <sequenceFlow id="f_lookupCustomer_reserveStock" sourceRef="lookupCustomer" targetRef="reserveStock"/>
    <serviceTask id="reserveStock" name="Reserve the stock" implementation="inventory.RESERVE" activiti:templateId="inventory.RESERVE" activiti:templateVersion="1"/>
    <boundaryEvent id="onReserveCompensate" name="Compensate the reservation" attachedToRef="reserveStock">
      <compensateEventDefinition/>
    </boundaryEvent>
    <serviceTask id="releaseStock" name="Release the stock" isForCompensation="true" activiti:expression="${execution.setVariable('stockReleased', true)}"/>
    <sequenceFlow id="f_reserveStock_chargePayment" sourceRef="reserveStock" targetRef="chargePayment"/>
    <serviceTask id="chargePayment" name="Charge the card" implementation="payment.CHARGE" activiti:templateId="payment.CHARGE" activiti:templateVersion="1"/>
    <boundaryEvent id="paymentDeclined" name="Payment declined" attachedToRef="chargePayment">
      <errorEventDefinition errorRef="paymentDeclinedError"/>
    </boundaryEvent>
    <sequenceFlow id="f_paymentDeclined_rollbackOrder" sourceRef="paymentDeclined" targetRef="rollbackOrder"/>
    <intermediateThrowEvent id="rollbackOrder" name="Roll back the order">
      <compensateEventDefinition/>
    </intermediateThrowEvent>
    <sequenceFlow id="f_rollbackOrder_declinedEnd" sourceRef="rollbackOrder" targetRef="declinedEnd"/>
    <endEvent id="declinedEnd" name="Cancelled: payment declined"/>
    <sequenceFlow id="f_chargePayment_fork" sourceRef="chargePayment" targetRef="fork"/>
    <parallelGateway id="fork" name="Prepare the shipment"/>
    <sequenceFlow id="f_fork_packOrder" sourceRef="fork" targetRef="packOrder"/>
    <sequenceFlow id="f_fork_createShipment" sourceRef="fork" targetRef="createShipment"/>
    <serviceTask id="packOrder" name="Pack the order" activiti:expression="${execution.setVariable('packed', true)}"/>
    <serviceTask id="createShipment" name="Create the shipping label" implementation="shipping.CREATE" activiti:templateId="shipping.CREATE" activiti:templateVersion="1"/>
    <sequenceFlow id="f_packOrder_join" sourceRef="packOrder" targetRef="join"/>
    <sequenceFlow id="f_createShipment_join" sourceRef="createShipment" targetRef="join"/>
    <parallelGateway id="join" name="Ready to ship"/>
    <sequenceFlow id="f_join_awaitPickup" sourceRef="join" targetRef="awaitPickup"/>
    <intermediateCatchEvent id="awaitPickup" name="Carrier picked up">
      <signalEventDefinition signalRef="carrierPickedUpSignal"/>
    </intermediateCatchEvent>
    <sequenceFlow id="f_awaitPickup_awaitDelivery" sourceRef="awaitPickup" targetRef="awaitDelivery"/>
    <intermediateCatchEvent id="awaitDelivery" name="Order delivered">
      <signalEventDefinition signalRef="orderDeliveredSignal"/>
    </intermediateCatchEvent>
    <sequenceFlow id="f_awaitDelivery_carrierGateway" sourceRef="awaitDelivery" targetRef="carrierGateway"/>
    <exclusiveGateway id="carrierGateway" name="Express carrier?" default="f_carrierGateway_standardNotice"/>
    <sequenceFlow id="f_carrierGateway_expressNotice" name="express" sourceRef="carrierGateway" targetRef="expressNotice">
      <conditionExpression xsi:type="tFormalExpression">${carrier == 'EXPRESS'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_carrierGateway_standardNotice" name="other" sourceRef="carrierGateway" targetRef="standardNotice"/>
    <serviceTask id="expressNotice" name="Send the express notice" activiti:expression="${execution.setVariable('notice', 'EXPRESS')}"/>
    <serviceTask id="standardNotice" name="Send the standard notice" activiti:expression="${execution.setVariable('notice', 'STANDARD')}"/>
    <sequenceFlow id="f_expressNotice_expressShippedEnd" sourceRef="expressNotice" targetRef="expressShippedEnd"/>
    <sequenceFlow id="f_standardNotice_shippedEnd" sourceRef="standardNotice" targetRef="shippedEnd"/>
    <endEvent id="expressShippedEnd" name="Shipped express"/>
    <endEvent id="shippedEnd" name="Shipped"/>
    <association id="a_onReserveCompensate_releaseStock" associationDirection="One" sourceRef="onReserveCompensate" targetRef="releaseStock"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="orderFulfilment">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
