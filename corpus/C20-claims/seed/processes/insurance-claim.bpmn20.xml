<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:activiti="http://activiti.org/bpmn"
             id="Definitions_insuranceClaim"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C20">
  <message id="claimWithdrawnMsg" name="claimWithdrawn"/>
  <message id="claimDocumentsMsg" name="claimDocuments"/>
  <process id="insuranceClaim" name="Insurance claim" isExecutable="true">
    <documentation>An insurance claim. A decision task triages the claim (claim type and amount give the severity and the number of reviewers); the claim is then assessed by that many adjusters of the adjusters group, in parallel (a multi-instance user task whose completion variable verdict is collected in verdicts). An exclusive gateway decides on the verdicts and the severity: a rejection ends the claim, a major claim needs the sign-off of a claims manager, everything else is paid. While the claim is open, a claimDocuments message starts a non-interrupting event sub process that logs the document, and a claimWithdrawn message ends the assessment through an interrupting boundary event (an interrupting message event sub process cannot interrupt an active multi-instance user task on Activiti 9.0.0, see the README). The payloads of both messages reach the process through the MAP_ALL mapping the modeler gives a message start or boundary event.</documentation>
    <startEvent id="start" name="Claim filed"/>
    <sequenceFlow id="f_start_triage" sourceRef="start" targetRef="triage"/>
    <serviceTask id="triage" name="Triage the claim" implementation="dmn-connector.EXECUTE_TABLE"/>
    <sequenceFlow id="f_triage_assessClaim" sourceRef="triage" targetRef="assessClaim"/>
    <userTask id="assessClaim" name="Assess the claim" activiti:candidateGroups="adjusters">
      <multiInstanceLoopCharacteristics isSequential="false">
        <loopCardinality>${reviewers}</loopCardinality>
        <loopDataOutputRef>verdicts</loopDataOutputRef>
        <outputDataItem name="verdict"/>
      </multiInstanceLoopCharacteristics>
    </userTask>
    <boundaryEvent id="onWithdrawal" name="Claim withdrawn" attachedToRef="assessClaim">
      <messageEventDefinition messageRef="claimWithdrawnMsg" activiti:correlationKey="${claimId}"/>
    </boundaryEvent>
    <sequenceFlow id="f_assessClaim_outcomeGateway" sourceRef="assessClaim" targetRef="outcomeGateway"/>
    <exclusiveGateway id="outcomeGateway" name="Outcome" default="f_outcomeGateway_payout"/>
    <sequenceFlow id="f_outcomeGateway_rejectedEnd" name="rejected" sourceRef="outcomeGateway" targetRef="rejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${verdicts.contains('REJECT')}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_outcomeGateway_managerSignOff" name="major" sourceRef="outcomeGateway" targetRef="managerSignOff">
      <conditionExpression xsi:type="tFormalExpression">${severity == 'MAJOR'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_outcomeGateway_payout" name="approved" sourceRef="outcomeGateway" targetRef="payout"/>
    <endEvent id="rejectedEnd" name="Rejected"/>
    <userTask id="managerSignOff" name="Sign off the payout" activiti:candidateGroups="claims-managers"/>
    <sequenceFlow id="f_managerSignOff_payout" sourceRef="managerSignOff" targetRef="payout"/>
    <serviceTask id="payout" name="Pay out the claim" activiti:expression="${execution.setVariable('paidAmount', claimAmount)}"/>
    <sequenceFlow id="f_payout_paidEnd" sourceRef="payout" targetRef="paidEnd"/>
    <endEvent id="paidEnd" name="Paid"/>
    <sequenceFlow id="f_onWithdrawal_recordWithdrawal" sourceRef="onWithdrawal" targetRef="recordWithdrawal"/>
    <serviceTask id="recordWithdrawal" name="Record the withdrawal" activiti:expression="${execution.setVariable('status', 'WITHDRAWN')}"/>
    <sequenceFlow id="f_recordWithdrawal_withdrawnEnd" sourceRef="recordWithdrawal" targetRef="withdrawnEnd"/>
    <endEvent id="withdrawnEnd" name="Withdrawn"/>
    <subProcess id="documentsHandler" name="Documents received" triggeredByEvent="true">
      <startEvent id="documentStart" name="Document received" isInterrupting="false">
        <messageEventDefinition messageRef="claimDocumentsMsg" activiti:correlationKey="${claimId}"/>
      </startEvent>
      <sequenceFlow id="f_documentStart_logDocument" sourceRef="documentStart" targetRef="logDocument"/>
      <serviceTask id="logDocument" name="Log the document" activiti:expression="${execution.setVariable('documentsLogged', (execution.getVariable('documentsLogged') != null ? execution.getVariable('documentsLogged') : 0) + 1)}"/>
      <sequenceFlow id="f_logDocument_documentLoggedEnd" sourceRef="logDocument" targetRef="documentLoggedEnd"/>
      <endEvent id="documentLoggedEnd" name="Document logged"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="insuranceClaim">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
