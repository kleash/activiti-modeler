  <message id="documentsReceivedMsg" name="documentsReceived"/>
  <process id="loanOrigination" name="Loan origination" isExecutable="true">
    <documentation>A personal loan application. The KYC check is a called process; its outcome and the credit score the analyst enters come back through the MAP_ALL mapping the modeler gives a call activity. A decision task evaluates the credit policy table and routes the application: decline, automatic offer, or manual underwriting by the underwriters group, escalated to the senior underwriters by a timer after 48 hours. The offer waits for the documentsReceived message, whose payload decides whether the loan is funded.</documentation>
    <startEvent id="start" name="Application received"/>
    <sequenceFlow id="f_start_kycCall" sourceRef="start" targetRef="kycCall"/>
    <callActivity id="kycCall" name="KYC check" calledElement="kycCheck"/>
    <sequenceFlow id="f_kycCall_kycGateway" sourceRef="kycCall" targetRef="kycGateway"/>
    <exclusiveGateway id="kycGateway" name="KYC passed?" default="f_kycGateway_assessRisk"/>
    <sequenceFlow id="f_kycGateway_kycRejectedEnd" name="failed" sourceRef="kycGateway" targetRef="kycRejectedEnd">
      <conditionExpression xsi:type="tFormalExpression">${kycStatus == 'FAILED'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_kycGateway_assessRisk" name="passed" sourceRef="kycGateway" targetRef="assessRisk"/>
    <endEvent id="kycRejectedEnd" name="Rejected: KYC failed"/>
    <serviceTask id="assessRisk" name="Assess credit risk" implementation="dmn-connector.EXECUTE_TABLE"/>
    <sequenceFlow id="f_assessRisk_routeGateway" sourceRef="assessRisk" targetRef="routeGateway"/>
    <exclusiveGateway id="routeGateway" name="Route" default="f_routeGateway_underwriting"/>
    <sequenceFlow id="f_routeGateway_declinedEnd" name="decline" sourceRef="routeGateway" targetRef="declinedEnd">
      <conditionExpression xsi:type="tFormalExpression">${route == 'DECLINE'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_routeGateway_prepareOffer" name="auto" sourceRef="routeGateway" targetRef="prepareOffer">
      <conditionExpression xsi:type="tFormalExpression">${route == 'AUTO'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_routeGateway_underwriting" name="manual" sourceRef="routeGateway" targetRef="underwriting"/>
    <endEvent id="declinedEnd" name="Declined: credit policy"/>
    <userTask id="underwriting" name="Underwrite the application" activiti:candidateGroups="underwriters"/>
    <boundaryEvent id="underwritingTimeout" name="48 hours without a decision" attachedToRef="underwriting">
      <timerEventDefinition>
        <timeDuration>PT48H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="f_underwriting_approvedGateway" sourceRef="underwriting" targetRef="approvedGateway"/>
    <sequenceFlow id="f_underwritingTimeout_seniorReview" sourceRef="underwritingTimeout" targetRef="seniorReview"/>
    <userTask id="seniorReview" name="Senior review" activiti:candidateGroups="senior-underwriters"/>
    <sequenceFlow id="f_seniorReview_approvedGateway" sourceRef="seniorReview" targetRef="approvedGateway"/>
    <exclusiveGateway id="approvedGateway" name="Approved?" default="f_approvedGateway_rejectedEnd"/>
    <sequenceFlow id="f_approvedGateway_prepareOffer" name="yes" sourceRef="approvedGateway" targetRef="prepareOffer">
      <conditionExpression xsi:type="tFormalExpression">${approved}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_approvedGateway_rejectedEnd" name="no" sourceRef="approvedGateway" targetRef="rejectedEnd"/>
    <endEvent id="rejectedEnd" name="Rejected by underwriting"/>
    <serviceTask id="prepareOffer" name="Prepare the offer" activiti:expression="${execution.setVariable('offerAmount', execution.getVariable('approvedAmount') != null ? execution.getVariable('approvedAmount') : amount)}"/>
    <sequenceFlow id="f_prepareOffer_awaitDocuments" sourceRef="prepareOffer" targetRef="awaitDocuments"/>
    <intermediateCatchEvent id="awaitDocuments" name="Documents received">
      <messageEventDefinition messageRef="documentsReceivedMsg" activiti:correlationKey="${applicationId}"/>
    </intermediateCatchEvent>
    <sequenceFlow id="f_awaitDocuments_documentsGateway" sourceRef="awaitDocuments" targetRef="documentsGateway"/>
    <exclusiveGateway id="documentsGateway" name="Documents complete?" default="f_documentsGateway_incompleteEnd"/>
    <sequenceFlow id="f_documentsGateway_disburse" name="yes" sourceRef="documentsGateway" targetRef="disburse">
      <conditionExpression xsi:type="tFormalExpression">${documentsComplete}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="f_documentsGateway_incompleteEnd" name="no" sourceRef="documentsGateway" targetRef="incompleteEnd"/>
    <serviceTask id="disburse" name="Disburse the loan" activiti:expression="${execution.setVariable('disbursed', true)}"/>
    <sequenceFlow id="f_disburse_fundedEnd" sourceRef="disburse" targetRef="fundedEnd"/>
    <endEvent id="fundedEnd" name="Funded"/>
    <endEvent id="incompleteEnd" name="Closed: documents incomplete"/>
  </process>
