<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_fulfilment" targetNamespace="http://kleash.github.io/corpus/C22" exporter="Camunda Modeler" exporterVersion="5.22.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:process id="fulfilOrder" name="Fulfil order" isExecutable="true" camunda:historyTimeToLive="30" camunda:versionTag="1.4" camunda:candidateStarterGroups="sales">
    <bpmn:extensionElements>
      <camunda:executionListener class="io.github.kleash.activiti.harness.support.RecordingExecutionListener" event="start" />
      <camunda:properties>
        <camunda:property name="owner" value="order-desk" />
      </camunda:properties>
    </bpmn:extensionElements>
    <bpmn:startEvent id="received" name="Order received" camunda:initiator="requester" camunda:formKey="forms/order">
      <bpmn:outgoing>Flow_toGreet</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="greetCustomer" name="Greet customer" camunda:expression="${greeter.greet(customerName)}" camunda:resultVariable="greeting">
      <bpmn:incoming>Flow_toGreet</bpmn:incoming>
      <bpmn:outgoing>Flow_toDiscount</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="applyDiscount" name="Apply discount" camunda:asyncBefore="true" camunda:asyncAfter="true" camunda:jobPriority="3" camunda:class="io.github.kleash.activiti.harness.support.SetVariableDelegate">
      <bpmn:extensionElements>
        <camunda:failedJobRetryTimeCycle>R2/PT1S</camunda:failedJobRetryTimeCycle>
        <camunda:field name="variable">
          <camunda:string>discount</camunda:string>
        </camunda:field>
        <camunda:field name="value">
          <camunda:expression>${quantity &gt;= 10 ? 15 : 0}</camunda:expression>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toDiscount</bpmn:incoming>
      <bpmn:outgoing>Flow_toRisk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="classifyRisk" name="Classify risk" camunda:resultVariable="risk" camunda:decisionRef="orderRisk" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_toRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_toReviewGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="needsReview" name="Discounted?" default="Flow_noReview">
      <bpmn:incoming>Flow_toReviewGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_review</bpmn:outgoing>
      <bpmn:outgoing>Flow_noReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reviewOrder" name="Review discount" camunda:candidateGroups="managers" camunda:dueDate="P2D" camunda:followUpDate="P1D" camunda:priority="80" camunda:formKey="forms/review">
      <bpmn:extensionElements>
        <camunda:taskListener class="io.github.kleash.activiti.harness.support.RecordingTaskListener" event="create" />
        <camunda:taskListener expression="${listenerRecorder.recordTask(task)}" event="assignment" />
        <camunda:taskListener class="io.github.kleash.activiti.harness.support.RecordingTaskListener" event="update" />
        <camunda:inputOutput>
          <camunda:inputParameter name="maxDiscount">20</camunda:inputParameter>
          <camunda:inputParameter name="orderValue">${quantity * 10}</camunda:inputParameter>
          <camunda:outputParameter name="approved">${decision}</camunda:outputParameter>
          <camunda:outputParameter name="verdict">${decision ? 'granted' : 'refused'}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_review</bpmn:incoming>
      <bpmn:outgoing>Flow_toApprovedGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="isApproved" name="Approved?" default="Flow_refused">
      <bpmn:incoming>Flow_toApprovedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_granted</bpmn:outgoing>
      <bpmn:outgoing>Flow_refused</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="packOrder" name="Pack order" camunda:delegateExpression="${recordingDelegate}">
      <bpmn:incoming>Flow_noReview</bpmn:incoming>
      <bpmn:incoming>Flow_granted</bpmn:incoming>
      <bpmn:outgoing>Flow_toShip</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="shipOrder" name="Ship order" calledElement="shippingLabel" camunda:calledElementBinding="latest">
      <bpmn:extensionElements>
        <camunda:in source="customerName" target="parcelOwner" />
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:out source="labelText" target="label" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toShip</bpmn:incoming>
      <bpmn:outgoing>Flow_toConfirm</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="confirmDispatch" name="Confirm dispatch" camunda:assignee="${requester}">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="dispatchNote" label="Note" type="string">
            <camunda:validation>
              <camunda:constraint name="required" />
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="carrier" label="Carrier" type="enum" defaultValue="post">
            <camunda:value id="post" name="Post" />
            <camunda:value id="courier" name="Courier" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_toDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="fulfilled" name="Order fulfilled">
      <bpmn:incoming>Flow_toDone</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="refusedEnd" name="Discount refused">
      <bpmn:incoming>Flow_refused</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_toGreet" sourceRef="received" targetRef="greetCustomer" />
    <bpmn:sequenceFlow id="Flow_toDiscount" sourceRef="greetCustomer" targetRef="applyDiscount" />
    <bpmn:sequenceFlow id="Flow_toRisk" sourceRef="applyDiscount" targetRef="classifyRisk" />
    <bpmn:sequenceFlow id="Flow_toReviewGateway" sourceRef="classifyRisk" targetRef="needsReview" />
    <bpmn:sequenceFlow id="Flow_review" name="yes" sourceRef="needsReview" targetRef="reviewOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${discount &gt; 0}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_noReview" name="no" sourceRef="needsReview" targetRef="packOrder" />
    <bpmn:sequenceFlow id="Flow_toApprovedGateway" sourceRef="reviewOrder" targetRef="isApproved" />
    <bpmn:sequenceFlow id="Flow_granted" name="granted" sourceRef="isApproved" targetRef="packOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_refused" name="refused" sourceRef="isApproved" targetRef="refusedEnd" />
    <bpmn:sequenceFlow id="Flow_toShip" sourceRef="packOrder" targetRef="shipOrder" />
    <bpmn:sequenceFlow id="Flow_toConfirm" sourceRef="shipOrder" targetRef="confirmDispatch" />
    <bpmn:sequenceFlow id="Flow_toDone" sourceRef="confirmDispatch" targetRef="fulfilled" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="fulfilOrder">
      <bpmndi:BPMNShape id="received_di" bpmnElement="received"><dc:Bounds x="152" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="greetCustomer_di" bpmnElement="greetCustomer"><dc:Bounds x="240" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="applyDiscount_di" bpmnElement="applyDiscount"><dc:Bounds x="390" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="classifyRisk_di" bpmnElement="classifyRisk"><dc:Bounds x="540" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="needsReview_di" bpmnElement="needsReview" isMarkerVisible="true"><dc:Bounds x="695" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewOrder_di" bpmnElement="reviewOrder"><dc:Bounds x="800" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="isApproved_di" bpmnElement="isApproved" isMarkerVisible="true"><dc:Bounds x="955" y="95" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="packOrder_di" bpmnElement="packOrder"><dc:Bounds x="1070" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shipOrder_di" bpmnElement="shipOrder"><dc:Bounds x="1220" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="confirmDispatch_di" bpmnElement="confirmDispatch"><dc:Bounds x="1370" y="190" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fulfilled_di" bpmnElement="fulfilled"><dc:Bounds x="1522" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="refusedEnd_di" bpmnElement="refusedEnd"><dc:Bounds x="962" y="22" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_toGreet_di" bpmnElement="Flow_toGreet"><di:waypoint x="188" y="230" /><di:waypoint x="240" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toDiscount_di" bpmnElement="Flow_toDiscount"><di:waypoint x="340" y="230" /><di:waypoint x="390" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toRisk_di" bpmnElement="Flow_toRisk"><di:waypoint x="490" y="230" /><di:waypoint x="540" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toReviewGateway_di" bpmnElement="Flow_toReviewGateway"><di:waypoint x="640" y="230" /><di:waypoint x="695" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_review_di" bpmnElement="Flow_review"><di:waypoint x="720" y="205" /><di:waypoint x="720" y="120" /><di:waypoint x="800" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_noReview_di" bpmnElement="Flow_noReview"><di:waypoint x="745" y="230" /><di:waypoint x="1070" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toApprovedGateway_di" bpmnElement="Flow_toApprovedGateway"><di:waypoint x="900" y="120" /><di:waypoint x="955" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_granted_di" bpmnElement="Flow_granted"><di:waypoint x="1005" y="120" /><di:waypoint x="1120" y="120" /><di:waypoint x="1120" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_refused_di" bpmnElement="Flow_refused"><di:waypoint x="980" y="95" /><di:waypoint x="980" y="58" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toShip_di" bpmnElement="Flow_toShip"><di:waypoint x="1170" y="230" /><di:waypoint x="1220" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toConfirm_di" bpmnElement="Flow_toConfirm"><di:waypoint x="1320" y="230" /><di:waypoint x="1370" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toDone_di" bpmnElement="Flow_toDone"><di:waypoint x="1470" y="230" /><di:waypoint x="1522" y="230" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
