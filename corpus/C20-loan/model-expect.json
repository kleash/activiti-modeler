{
  "$schema": "../../schemas/model-expect.schema.json",
  "description": "What the engine's own reader makes of the project: the user tasks, the call activity and the message catch event carry MAP_ALL and nothing else (the default the modeler writes, ADR 0006); only the decision task has explicit inputs, outputs and the table constant.",
  "processes": {
    "loanOrigination": {
      "definition": { "name": "Loan origination", "category": "http://activiti.org/bpmn/corpus/C20" },
      "extensions": {
        "properties": {
          "applicationId": { "type": "string" },
          "amount": { "type": "integer" },
          "creditScore": { "type": "integer" },
          "riskClass": { "type": "string" },
          "route": { "type": "string" },
          "creditRules": { "type": "array" },
          "approved": { "type": "boolean" },
          "documentsComplete": { "type": "boolean" }
        },
        "mappings": {
          "kycCall": { "mappingType": "MAP_ALL", "inputs": { "$size": 0 }, "outputs": { "$size": 0 } },
          "underwriting": { "mappingType": "MAP_ALL", "inputs": { "$size": 0 }, "outputs": { "$size": 0 } },
          "seniorReview": { "mappingType": "MAP_ALL", "inputs": { "$size": 0 }, "outputs": { "$size": 0 } },
          "awaitDocuments": { "mappingType": "MAP_ALL", "inputs": { "$size": 0 }, "outputs": { "$size": 0 } },
          "assessRisk": {
            "mappingType": null,
            "inputs": {
              "creditScore": { "type": "VARIABLE", "value": "creditScore" },
              "amount": { "type": "VARIABLE", "value": "amount" }
            },
            "outputs": {
              "riskClass": { "type": "VARIABLE", "value": "riskClass" },
              "route": { "type": "VARIABLE", "value": "route" },
              "creditRules": { "type": "VARIABLE", "value": "_activiti_dmn_matched_rules_" }
            }
          },
          "prepareOffer": { "$exists": false },
          "disburse": { "$exists": false }
        },
        "constants": {
          "assessRisk": { "_activiti_dmn_table_": "creditDecision" },
          "kycCall": { "$exists": false }
        }
      },
      "elements": {
        "kycCall": { "type": "callActivity", "attributes": { "calledElement": "kycCheck", "inheritVariables": false, "inParameters": [], "outParameters": [] } },
        "assessRisk": { "type": "serviceTask", "attributes": { "implementation": "dmn-connector.EXECUTE_TABLE" } },
        "underwriting": { "type": "userTask", "attributes": { "candidateGroups": ["underwriters"], "assignee": null } },
        "seniorReview": { "type": "userTask", "attributes": { "candidateGroups": ["senior-underwriters"] } },
        "underwritingTimeout": { "type": "boundaryEvent", "attributes": { "cancelActivity": true, "attachedToRefId": "underwriting" } },
        "awaitDocuments": { "type": "intermediateCatchEvent" },
        "routeGateway": { "type": "exclusiveGateway", "attributes": { "defaultFlow": "f_routeGateway_underwriting" } }
      }
    },
    "kycCheck": {
      "definition": { "name": "KYC check", "category": "http://activiti.org/bpmn/corpus/C20" },
      "extensions": {
        "properties": {
          "idVerified": { "type": "boolean" },
          "creditScore": { "type": "integer" },
          "kycStatus": { "type": "string" }
        },
        "mappings": {
          "verifyIdentity": { "mappingType": "MAP_ALL", "inputs": { "$size": 0 }, "outputs": { "$size": 0 } },
          "markPassed": { "$exists": false },
          "markFailed": { "$exists": false }
        }
      },
      "elements": {
        "verifyIdentity": { "type": "userTask", "attributes": { "candidateGroups": ["kyc-analysts"] } }
      }
    }
  }
}
