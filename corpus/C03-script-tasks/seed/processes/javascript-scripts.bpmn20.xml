<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:activiti="http://activiti.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://activiti.org/bpmn/corpus/C03">
  <process id="javascriptScripts" name="JavaScript scripts" isExecutable="true">
    <documentation>JavaScript (Nashorn) script tasks under three engine names: variables are visible by name, execution.setVariable writes, the value of the last expression goes to the result variable.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_sumPrices" sourceRef="start" targetRef="sumPrices"/>
    <scriptTask id="sumPrices" name="Sum the prices" scriptFormat="javascript" activiti:resultVariable="itemCount">
      <script>var total = 0;
for (var i = 0; i &lt; prices.size(); i++) {
  total += prices.get(i);
}
execution.setVariable('sum', total);
prices.size();</script>
    </scriptTask>
    <sequenceFlow id="f_sumPrices_scale" sourceRef="sumPrices" targetRef="scale"/>
    <scriptTask id="scale" name="Scale the sum" scriptFormat="js" activiti:resultVariable="scaled">
      <script>sum * factor</script>
    </scriptTask>
    <sequenceFlow id="f_scale_summarize" sourceRef="scale" targetRef="summarize"/>
    <scriptTask id="summarize" name="Summarize" scriptFormat="ECMAScript" activiti:resultVariable="summary">
      <script>'items=' + itemCount + ', scaled=' + scaled</script>
    </scriptTask>
    <sequenceFlow id="f_summarize_end" sourceRef="summarize" targetRef="end"/>
    <endEvent id="end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="javascriptScripts">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="102" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sumPrices_di" bpmnElement="sumPrices">
        <dc:Bounds x="220" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="scale_di" bpmnElement="scale">
        <dc:Bounds x="370" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="summarize_di" bpmnElement="summarize">
        <dc:Bounds x="520" y="70" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="702" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_sumPrices_di" bpmnElement="f_start_sumPrices">
        <di:waypoint x="138" y="110"/>
        <di:waypoint x="220" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_sumPrices_scale_di" bpmnElement="f_sumPrices_scale">
        <di:waypoint x="320" y="110"/>
        <di:waypoint x="370" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_scale_summarize_di" bpmnElement="f_scale_summarize">
        <di:waypoint x="470" y="110"/>
        <di:waypoint x="520" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_summarize_end_di" bpmnElement="f_summarize_end">
        <di:waypoint x="620" y="110"/>
        <di:waypoint x="702" y="110"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
