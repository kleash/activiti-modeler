  <process id="asyncSubProcess" name="Asynchronous sub process" isExecutable="true">
    <documentation>An asynchronous, non-exclusive sub process: entering it creates a job; its content runs when the job is executed.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_prepare" sourceRef="start" targetRef="prepare"/>
    <subProcess id="prepare" name="Prepare" activiti:async="true" activiti:exclusive="false">
