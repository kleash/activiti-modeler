{
  "$schema": "../../../schemas/scenario.schema.json",
  "name": "Loan decision DRD, referenced as loanOffer",
  "users": {
    "alice": []
  },
  "scenarios": [
    {
      "name": "low risk country and age, amount within the limit",
      "start": {
        "process": "loanApplication",
        "user": "alice",
        "variables": {
          "age": 30,
          "country": "DE",
          "income": 5000,
          "amount": 15000
        }
      },
      "expect": {
        "state": "COMPLETED",
        "endEvents": [
          "approvedEnd"
        ],
        "path": {
          "contains": [
            "decideOffer",
            "routeOffer",
            "approvedEnd"
          ],
          "notContains": [
            "reviewEnd",
            "declinedEnd"
          ],
          "order": [
            [
              "start",
              "decideOffer"
            ],
            [
              "decideOffer",
              "routeOffer"
            ],
            [
              "routeOffer",
              "approvedEnd"
            ]
          ],
          "sequenceFlows": [
            "flow_start_decideOffer",
            "flow_decideOffer_routeOffer",
            "flow_routeOffer_approvedEnd"
          ]
        },
        "variables": {
          "offer": "APPROVE",
          "matched": true,
          "matchedRules": [
            "loanOffer_approve"
          ]
        }
      }
    },
