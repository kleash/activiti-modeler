  <error id="childErrorEndError" name="Child error end" errorCode="CHILD_ERROR_END"/>
  <process id="mapExceptionCallActivity" name="Errors crossing a call activity" isExecutable="true">
    <documentation>The called process riskyChild fails in one of three ways. A Java exception of an activiti:class task in the child that the child does not map is mapped by the mapException of the call activity (any RuntimeException, children included) to CHILD_FAILED. A BpmnError thrown in the child and an error end event of the child travel up to the error boundary events of the call activity. The child instance is deleted when the error is caught.</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_callChild" sourceRef="start" targetRef="callChild"/>
    <callActivity id="callChild" name="Call risky child" calledElement="riskyChild">
      <extensionElements>
        <activiti:in source="errorCode" target="errorCode"/>
        <activiti:in source="exceptionClass" target="exceptionClass"/>
        <activiti:in source="endWithError" target="endWithError"/>
        <activiti:mapException errorCode="CHILD_FAILED" includeChildExceptions="true">java.lang.RuntimeException</activiti:mapException>
      </extensionElements>
    </callActivity>
    <sequenceFlow id="f_callChild_childOk" sourceRef="callChild" targetRef="childOk"/>
    <endEvent id="childOk" name="Child ok"/>
    <boundaryEvent id="onChildFailed" name="Child failed" attachedToRef="callChild">
      <errorEventDefinition errorRef="childFailedError"/>
    </boundaryEvent>
    <sequenceFlow id="f_onChildFailed_childFailedEnd" sourceRef="onChildFailed" targetRef="childFailedEnd"/>
    <endEvent id="childFailedEnd" name="Child failed"/>
    <boundaryEvent id="onChildBpmnError" name="Child BPMN error" attachedToRef="callChild">
      <errorEventDefinition errorRef="childBpmnError"/>
    </boundaryEvent>
    <sequenceFlow id="f_onChildBpmnError_childBpmnErrorEnd" sourceRef="onChildBpmnError" targetRef="childBpmnErrorEnd"/>
    <endEvent id="childBpmnErrorEnd" name="Child BPMN error"/>
    <boundaryEvent id="onChildErrorEnd" name="Child error end" attachedToRef="callChild">
      <errorEventDefinition errorRef="childErrorEndError"/>
    </boundaryEvent>
    <sequenceFlow id="f_onChildErrorEnd_childErrorEndEnd" sourceRef="onChildErrorEnd" targetRef="childErrorEndEnd"/>
    <endEvent id="childErrorEndEnd" name="Child error end"/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
