        <di:waypoint x="295" y="200"/>
        <di:waypoint x="402" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_fork_waitMessage_di" bpmnElement="f_fork_waitMessage">
