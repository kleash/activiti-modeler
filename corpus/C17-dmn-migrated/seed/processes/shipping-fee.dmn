<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="shippingFees" name="Shipping fees" namespace="http://activiti.org/schema/1.0/dmn/shippingFees">
  <inputData id="InputData_weight" name="weight">
    <variable id="InputData_weight_variable" name="weight" typeRef="number" />
  </inputData>
  <inputData id="InputData_express" name="express">
    <variable id="InputData_express_variable" name="express" typeRef="boolean" />
  </inputData>
  <decision id="shippingFee" name="Shipping fee">
    <variable id="shippingFee_variable" name="Shipping fee" />
    <informationRequirement id="shippingFee_req_InputData_weight">
      <requiredInput href="#InputData_weight" />
    </informationRequirement>
    <informationRequirement id="shippingFee_req_InputData_express">
      <requiredInput href="#InputData_express" />
    </informationRequirement>
    <decisionTable id="DecisionTable_shippingFee" hitPolicy="FIRST">
      <input id="Input_weight" label="Weight">
        <inputExpression id="InputExpression_weight" typeRef="number">
          <text>weight</text>
        </inputExpression>
      </input>
      <input id="Input_express" label="Express">
        <inputExpression id="InputExpression_express" typeRef="boolean">
          <text>express</text>
        </inputExpression>
      </input>
      <output id="Output_fee" label="Fee" name="fee" typeRef="number" />
      <rule id="Rule_express">
        <inputEntry id="UnaryTests_1"><text>-</text></inputEntry>
        <inputEntry id="UnaryTests_2"><text>true</text></inputEntry>
        <outputEntry id="LiteralExpression_1"><text>25</text></outputEntry>
      </rule>
      <rule id="Rule_light">
        <inputEntry id="UnaryTests_3"><text>&lt; 2</text></inputEntry>
        <inputEntry id="UnaryTests_4"><text>-</text></inputEntry>
        <outputEntry id="LiteralExpression_2"><text>5</text></outputEntry>
      </rule>
      <rule id="Rule_heavy">
        <inputEntry id="UnaryTests_5"><text>&gt;= 2</text></inputEntry>
        <inputEntry id="UnaryTests_6"><text>-</text></inputEntry>
        <outputEntry id="LiteralExpression_3"><text>12.5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
