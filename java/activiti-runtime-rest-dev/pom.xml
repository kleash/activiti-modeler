<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.kleash.activiti</groupId>
    <artifactId>activiti-modeler-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>activiti-runtime-rest-dev</artifactId>
  <name>Activiti runtime REST (dev)</name>
  <description>Development-only REST endpoints (validate, deploy, scenario run, decisions, workspace). Opt-in, used by the modeler server.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.kleash.activiti</groupId>
      <artifactId>activiti-runtime-rest-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.kleash.activiti</groupId>
      <artifactId>activiti-scenario-runner</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.kleash.activiti</groupId>
      <artifactId>activiti-dmn-connector</artifactId>
    </dependency>

    <!-- Provided by the application that enables the dev endpoints. -->
    <dependency>
      <groupId>org.activiti</groupId>
      <artifactId>activiti-spring-boot-starter</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The scratch engine of the trial deployment runs on an in-memory H2 database of its own. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
