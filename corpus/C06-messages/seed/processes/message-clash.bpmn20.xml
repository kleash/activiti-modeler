  <message id="docsMsg" name="docs"/>
  <process id="messageClash" name="Boundary and event sub process on one message" isExecutable="true">
    <documentation>The user task has a boundary message docs and the process an event sub process started by the same message docs, neither with a correlation key. While the receive task before the user task waits only the event sub process subscribes; at the user task both do (lint L30).</documentation>
    <startEvent id="start"/>
    <sequenceFlow id="f_start_prepare" sourceRef="start" targetRef="prepare"/>
    <receiveTask id="prepare" name="Prepare"/>
    <sequenceFlow id="f_prepare_collect" sourceRef="prepare" targetRef="collect"/>
    <userTask id="collect" name="Collect the documents" activiti:assignee="ann"/>
    <boundaryEvent id="docsBoundary" name="Docs (boundary)" cancelActivity="false" attachedToRef="collect">
      <messageEventDefinition messageRef="docsMsg"/>
    </boundaryEvent>
    <sequenceFlow id="f_docsBoundary_boundaryEnd" sourceRef="docsBoundary" targetRef="boundaryEnd"/>
    <endEvent id="boundaryEnd" name="Docs via boundary"/>
    <sequenceFlow id="f_collect_collectedEnd" sourceRef="collect" targetRef="collectedEnd"/>
    <endEvent id="collectedEnd" name="Collected"/>
    <subProcess id="docsHandler" name="Docs handler" triggeredByEvent="true">
      <startEvent id="docsStart" name="Docs (event sub process)" isInterrupting="false">
        <messageEventDefinition messageRef="docsMsg"/>
      </startEvent>
      <sequenceFlow id="f_docsStart_handlerEnd" sourceRef="docsStart" targetRef="handlerEnd"/>
      <endEvent id="handlerEnd" name="Docs via event sub process"/>
    </subProcess>
  </process>
