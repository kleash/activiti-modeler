      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f_start_fork_di" bpmnElement="f_start_fork">
        <di:waypoint x="138" y="220"/>
        <di:waypoint x="245" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_fork_taskA_di" bpmnElement="f_fork_taskA">
